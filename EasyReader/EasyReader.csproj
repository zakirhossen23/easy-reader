<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>EasyReader</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>EasyReader</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.easyreader</ApplicationId>

		<!-- Versions -->
      <!-- Versions: keep a single consistent package/version across all TFMs to avoid NU1105 -->
		<ApplicationDisplayVersion>2.1.18</ApplicationDisplayVersion>
		<ApplicationVersion>2118</ApplicationVersion>
		<!-- Explicit PackageVersion to ensure NuGet restore uses the same value for all target frameworks -->
		<PackageVersion>2.1.18</PackageVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!-- Disable Fast Deployment on Android devices that don't support it by embedding assemblies into the APK -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
	  <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
	  <!-- Force MSBuild to use JDK 21 (update the path if your JDK is installed elsewhere) -->
	  <JavaSdkDirectory>C:\Program Files\Eclipse Adoptium\jdk-21.0.10.7-hotspot</JavaSdkDirectory>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-android|AnyCPU'">
	  <AndroidPackageFormat>aab</AndroidPackageFormat>
	  <ApplicationId>com.creativetech.easyreader_v2_1_2</ApplicationId>
	  <ApplicationDisplayVersion>2.1.18</ApplicationDisplayVersion>
	  <ApplicationVersion>2118</ApplicationVersion>
	  <AndroidUseAapt2>True</AndroidUseAapt2>
	  <AndroidCreatePackagePerAbi>False</AndroidCreatePackagePerAbi>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-android|AnyCPU'">
	  <ApplicationId>com.creativetech.easyreader_v2_1_2</ApplicationId>
	  <ApplicationDisplayVersion>2.1.18</ApplicationDisplayVersion>
	  <ApplicationVersion>2118</ApplicationVersion>
	  <AndroidUseAapt2>True</AndroidUseAapt2>
	  <AndroidCreatePackagePerAbi>False</AndroidCreatePackagePerAbi>
	  <AndroidPackageFormat>aab</AndroidPackageFormat>
	  <DebugSymbols>true</DebugSymbols>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-ios|AnyCPU'">
	  <ApplicationId>com.creativetechusa.easyreader</ApplicationId>
	  <ApplicationDisplayVersion>2.1.18</ApplicationDisplayVersion>
	  <ApplicationVersion>2118</ApplicationVersion>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-maccatalyst|AnyCPU'">
	  <ApplicationId>com.creativetech.easyreader_v2_1_2</ApplicationId>
	  <ApplicationDisplayVersion>2.1.18</ApplicationDisplayVersion>
	  <ApplicationVersion>2118</ApplicationVersion>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-windows10.0.19041.0|AnyCPU'">
	  <ApplicationId>com.creativetech.easyreader_v2_1_2</ApplicationId>
	  <ApplicationDisplayVersion>2.1.18</ApplicationDisplayVersion>
	  <ApplicationVersion>2118</ApplicationVersion>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-ios|AnyCPU'">
	  <ApplicationId>com.creativetechusa.easyreader</ApplicationId>
	  <ApplicationDisplayVersion>2.1.18</ApplicationDisplayVersion>
	  <ApplicationVersion>2118</ApplicationVersion>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-maccatalyst|AnyCPU'">
	  <ApplicationId>com.creativetech.easyreader_v2_1_2</ApplicationId>
	  <ApplicationDisplayVersion>2.1.18</ApplicationDisplayVersion>
	  <ApplicationVersion>2118</ApplicationVersion>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-windows10.0.19041.0|AnyCPU'">
	  <ApplicationId>com.creativetech.easyreader_v2_1_2</ApplicationId>
	  <ApplicationDisplayVersion>2.1.18</ApplicationDisplayVersion>
	  <ApplicationVersion>2118</ApplicationVersion>
	</PropertyGroup>

	<ItemGroup>
        <!-- App Icon - use vector SVG source so MAUI generates correct platform icons -->

        <!-- Splash Screen - use SVG source if available so MAUI generates platform-specific splash images -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="512,512" />

		<!-- Images (include subfolders like Icons) -->
		<MauiImage Include="Resources\Images\**\*" />
		
		<!-- Xamarin logos copied into MAUI Resources -->

		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <!-- Remove legacy Android platform-specific images so MAUI-generated icons are used instead -->
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <!-- Remove any drawable or mipmap PNGs that may conflict with MAUI generated assets -->
        <MauiImage Remove="Platforms\Android\Resources\drawable\*.png" />
        <MauiImage Remove="Platforms\Android\Resources\mipmap-**\*.png" />
        <!-- Remove any legacy adaptive icon xml that references old images -->
        <MauiImage Remove="Platforms\Android\Resources\mipmap-**\*.xml" />
    </ItemGroup>

    <!-- Also ensure AndroidResource items are not included for legacy platform images -->
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <AndroidResource Remove="Platforms\Android\Resources\drawable\*.png" />
        <AndroidResource Remove="Platforms\Android\Resources\mipmap-**\*.png" />
        <AndroidResource Remove="Platforms\Android\Resources\mipmap-**\*.xml" />
    </ItemGroup>
    <ItemGroup>
      <AndroidResource Remove="Platforms\Android\Resources\drawable\splash_background.xml" />
      <AndroidResource Remove="Platforms\Android\Resources\drawable\splash_logo.xml" />
      <AndroidResource Remove="Platforms\Android\Resources\drawable\watermark_g.xml" />
    </ItemGroup>
    <ItemGroup>
      <None Remove="Platforms\Android\Resources\drawable\icon_legacy.png" />
      <None Remove="Platforms\Android\Resources\drawable\splash_background.png" />
    </ItemGroup>
    <ItemGroup>
      <MauiImage Include="Platforms\Android\Resources\drawable\icon_legacy.png" />
      <MauiImage Include="Platforms\Android\Resources\drawable\splash_background.png" />
      <MauiIcon Include="Resources\AppIcon\appicon.png" />
    </ItemGroup>
 

	<!-- Local copied icons available under Resources/Images/Icons -->

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="13.0.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="PdfJSViewer-MAUI" Version="1.0.3" />
		<PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
		<PackageReference Include="SQLiteNetExtensions" Version="2.1.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="CsvHelper" Version="30.0.1" />
		<PackageReference Include="FluentFTP" Version="41.0.0" />
		<PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
		<!-- Replaced Acr.UserDialogs and Xam.Plugin.Media with MAUI-friendly services -->
		
	</ItemGroup>

	<!-- Play Core for Android in-app updates (Android-only) -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
	  <PackageReference Include="Xamarin.Google.Android.Play.Core" Version="1.10.3.21" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
	  <PackageReference Include="Xamarin.GooglePlayServices.Tasks" Version="118.0.0" />
	</ItemGroup>

    <!-- If you add a PDF, place it under Resources/Raw/ and it will be included automatically by the MauiAsset above -->

	<ItemGroup>
	  <MauiXaml Update="Views\EmailPhotosPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\FileManagerPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\SplashPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>


</Project>
