<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- diagonal gradient background -->
  <item>
    <shape android:shape="rectangle">
      <gradient android:angle="315" android:startColor="#0f1736" android:endColor="#233a66" />
    </shape>
  </item>

  <!-- placeholder watermark image (expects drawable/watermark_g) anchored bottom|right -->
  <item android:gravity="right|bottom" android:drawable="@drawable/watermark_g" />

  <!-- centered logo/branding (expects drawable/splash_logo) -->
  <item android:gravity="center" android:drawable="@drawable/splash_logo" />
</layer-list>