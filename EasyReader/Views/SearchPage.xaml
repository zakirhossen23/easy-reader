<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://schemas.microsoft.com/dotnet/2021/maui/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodel="clr-namespace:EasyReader.ViewModels"
             mc:Ignorable="d"
             x:Class="EasyReader.Views.SearchPage"
             BackgroundColor="White">

    <!-- VIEW MODEL + TITLE VIEW + TOOLBAR-->
    <ContentPage.BindingContext>
        <viewmodel:SearchViewModel/>
    </ContentPage.BindingContext>
    <Shell.TitleView>
        <Label Text="Search" Style="{StaticResource LblTitleView}"/>
    </Shell.TitleView>
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Home" Command="{Binding GoTo_MainPage_Command}" Order="Primary" Priority="0"/>
        <ToolbarItem IconImageSource="settings.png" Command="{Binding GoTo_SettingsPage_Command}" Order="Primary" Priority="1"/>
    </ContentPage.ToolbarItems>
    <!--END-->

    <Grid Style="{StaticResource GridPadding}" ColumnDefinitions="2*, 3*">
        <Grid.RowDefinitions>
            <RowDefinition Height="{OnIdiom Tablet=36, Phone=26}"/>
            <RowDefinition Height="{OnIdiom Tablet=36, Phone=26}"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--FILE STATUSES-->
        <BoxView Style="{StaticResource BoxName}" Grid.Column="0" Grid.Row="0"/>
        <BoxView Style="{StaticResource BoxValue}" Grid.Column="1" Grid.Row="0"/>
        <BoxView Style="{StaticResource BoxName}" Grid.Column="0" Grid.Row="1"/>
        <BoxView Style="{StaticResource BoxValue}" Grid.Column="1" Grid.Row="1"/>

        <Label Text="Missing Readings:" Style="{StaticResource LblLarge}" Grid.Column="0" Grid.Row="0"/>
        <Label Text="{Binding MissingReadingsStatusLabel}" Style="{StaticResource LblLarge}" HorizontalTextAlignment="Center"
               Grid.Column="1" Grid.Row="0"/>
        <Label Style="{StaticResource LblLarge}" Grid.Column="0" Grid.Row="1">
            <Label.Text>
                <OnIdiom x:TypeArguments="x:String" Tablet="Open Service Orders:" Phone="Open SO's:"/>
            </Label.Text>
        </Label>
        <Label Text="{Binding OpenSOsStatusLabel}" Style="{StaticResource LblLarge}" HorizontalTextAlignment="Center"
               Grid.Column="1" Grid.Row="1"/>
        <!--END FILE STATUSES-->

        <!--SEARCH BAR + LIST VIEW-->
        <Frame BorderColor="{StaticResource PrimaryDkOffset}" BackgroundColor="Transparent" CornerRadius="10"
               Padding="10" HasShadow="False" Grid.ColumnSpan="2" Grid.Row="2" Grid.RowSpan="2"/>
        <SearchBar x:Name="searchBar" Text="{Binding SearchBarQuery}" Placeholder="Search Accounts..." PlaceholderColor="{StaticResource Primary}"
                   SearchCommand="{Binding PerformSearch_Command}" SearchCommandParameter="{Binding Text, Source={x:Reference searchBar}}"
                   BackgroundColor="Transparent" FontSize="16" TextColor="{StaticResource Primary}" CancelButtonColor="Red"
                   HorizontalOptions="Fill" Grid.ColumnSpan="2" Grid.Row="2"/>
        <ListView x:Name="searchResults" ItemsSource="{Binding SearchResultsList}" SelectedItem="{Binding SelectedSearchResult}"
                  BackgroundColor="Transparent" Margin="15, 0, 15, 15" Grid.ColumnSpan="2" Grid.Row="3">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell Tapped="SearchViewCellTapped">
                        <Label Text="{Binding .}" TextColor="{StaticResource Primary}" VerticalTextAlignment="Center"/>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <!--END SEARCH BAR + LIST VIEW-->
    </Grid>
</ContentPage>